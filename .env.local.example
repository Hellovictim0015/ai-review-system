# Copy this file to .env.local (and add the same values in Vercel → Settings → Environment Variables).
# No AI key is needed: reviews come from the ready-made pack in data/reviews/.

# --- 30-day "no repeat" memory (required on Vercel) ---
# Create a free Upstash Redis database (Vercel → Storage → Upstash Redis, or upstash.com)
# and paste its REST URL and token. Without these, local dev saves to .data/used-reviews.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: how many days before a posted review can be suggested again (default 30)
# NO_REPEAT_DAYS=30

# --- Optional rate limiting (per IP) ---
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=600000
