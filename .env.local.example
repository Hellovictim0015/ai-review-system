# Copy this file to .env.local and fill in ONE provider's key.
# These values are only read on the server — never prefix them with NEXT_PUBLIC_.

# Which AI provider to use: gemini | openai | anthropic
AI_PROVIDER=gemini

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Anthropic Claude (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Optional rate limiting (per IP) ---
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=600000
